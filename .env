# ==============================
# SafeLog AI — Configurações
# Copie este arquivo para .env
# e preencha com seus dados reais
# ==============================

# SERVIDOR
PORT=3001
NODE_ENV=development

# BANCO DE DADOS (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safelog
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# WHATSAPP (Z-API — https://z-api.io)
# Opção 1: Z-API (mais fácil, brasileiro)
ZAPI_INSTANCE_ID=seu_instance_id
ZAPI_TOKEN=seu_token
ZAPI_PHONE=5583999990000   # número do gestor (com DDI, sem + e espaços)

# Opção 2: Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+5583999990000

# EMAIL (SendGrid — https://sendgrid.com)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=alertas@safelog.com.br
EMAIL_TO=gestor@empresa.com
EMAIL_CC=seguranca@empresa.com

# Alternativa: SMTP (Gmail, etc)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_de_app

# SEGURANÇA
API_KEY=safelog_chave_secreta_aqui
JWT_SECRET=troque_por_string_aleatoria_longa

# FRONTEND (para CORS)
FRONTEND_URL=http://localhost:3000
